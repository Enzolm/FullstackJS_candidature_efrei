{
  "manifest_version": 3,
  "name": "TrackMyApply Documents",
  "version": "0.1.1",
  "description": "Dépose tes documents TrackMyApply dans les formulaires de candidature.",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "https://mail.google.com/*",
    "https://*.indeed.com/*"
  ],
  "action": {
    "default_title": "Ouvrir TrackMyApply"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://*.indeed.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["auth-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
